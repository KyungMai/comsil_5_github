if [ $# -eq 0 ]
then
echo "Usage: phone searchfor [...search for]"
echo "(You didn't tell me what you want to search for.)"
else
if [ -f "$HOME/mydata" ]
then
pattern=""
for arg in "$@"
do
	if [ "$arg" = "|" ]
	then
		continue
	fi

	if [ -z "$pattern" ]
	then
		pattern="$arg"
	else
		pattern="$pattern|$arg"
	fi
done

if [ -n "$pattern" ]
then
	egrep "($pattern)" "$HOME/mydata" | awk -f display.awk
fi
fi
fi
